@model OneJaxDashboard.Models.BudgetTracking_28D
@{
    ViewData["Title"] = "Edit Annual Budget Tracking Record";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="headline mb-4" style="color:var(--onejax-navy);">Edit Annual Budget Tracking Record</h1>

<div class="container mt-4">
    <div class="card p-4" style="background-color:var(--onejax-white); box-shadow:0 4px 24px rgba(0,0,0,0.08); border-radius:24px; max-width:900px;">

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <form asp-controller="DataEntry" asp-action="EditBudgetRecord" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedDate" />

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Quarter" class="form-label fw-bold">Quarter</label>
                    <select asp-for="Quarter" class="form-select">
                        <option value="">-- Select Quarter --</option>
                        <option value="Q1">Q1 (January - March)</option>
                        <option value="Q2">Q2 (April - June)</option>
                        <option value="Q3">Q3 (July - September)</option>
                        <option value="Q4">Q4 (October - December)</option>
                    </select>
                    <span asp-validation-for="Quarter" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Year" class="form-label fw-bold">Year</label>
                    <input asp-for="Year" type="number" min="2022" max="2100" class="form-control" />
                    <span asp-validation-for="Year" class="text-danger"></span>
                </div>
            </div>

            <h5 class="mt-4 mb-3" style="color:var(--onejax-navy); border-bottom:2px solid #dee2e6; padding-bottom:0.5rem;">Expenditures</h5>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="PersonnelExpenses" class="form-label fw-bold">Personnel Expenses</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="PersonnelExpenses" type="number" step="0.01" min="0" class="form-control" />
                    </div>
                    <span asp-validation-for="PersonnelExpenses" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ContractProfessionalServices" class="form-label fw-bold">Contract &amp; Professional Services</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="ContractProfessionalServices" type="number" step="0.01" min="0" class="form-control" />
                    </div>
                    <span asp-validation-for="ContractProfessionalServices" class="text-danger"></span>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="OperatingExpenses" class="form-label fw-bold">Operating Expenses</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="OperatingExpenses" type="number" step="0.01" min="0" class="form-control" />
                    </div>
                    <span asp-validation-for="OperatingExpenses" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ProgramExpenses" class="form-label fw-bold">Program Expenses</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="ProgramExpenses" type="number" step="0.01" min="0" class="form-control" />
                    </div>
                    <span asp-validation-for="ProgramExpenses" class="text-danger"></span>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="AdvertisingMarketing" class="form-label fw-bold">Advertising &amp; Marketing</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="AdvertisingMarketing" type="number" step="0.01" min="0" class="form-control" />
                    </div>
                    <span asp-validation-for="AdvertisingMarketing" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ProfessionalDevelopmentExpense" class="form-label fw-bold">Professional Development</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="ProfessionalDevelopmentExpense" type="number" step="0.01" min="0" class="form-control" />
                    </div>
                    <span asp-validation-for="ProfessionalDevelopmentExpense" class="text-danger"></span>
                </div>
            </div>

            <h5 class="mt-4 mb-3" style="color:var(--onejax-navy); border-bottom:2px solid #dee2e6; padding-bottom:0.5rem;">Revenues</h5>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="IndividualGiving" class="form-label fw-bold">Individual Giving</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="IndividualGiving" type="number" step="0.01" min="0" class="form-control" />
                    </div>
                    <span asp-validation-for="IndividualGiving" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CorporateFoundationGrants" class="form-label fw-bold">Corporate &amp; Foundation Grants</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="CorporateFoundationGrants" type="number" step="0.01" min="0" class="form-control" />
                    </div>
                    <span asp-validation-for="CorporateFoundationGrants" class="text-danger"></span>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="HumanitarianAwards" class="form-label fw-bold">Humanitarian Awards</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="HumanitarianAwards" type="number" step="0.01" min="0" class="form-control" />
                    </div>
                    <span asp-validation-for="HumanitarianAwards" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ProgramRevenue" class="form-label fw-bold">Program Revenue</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="ProgramRevenue" type="number" step="0.01" min="0" class="form-control" />
                    </div>
                    <span asp-validation-for="ProgramRevenue" class="text-danger"></span>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="PeopleCultureWorkshops" class="form-label fw-bold">People &amp; Culture Workshops</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="PeopleCultureWorkshops" type="number" step="0.01" min="0" class="form-control" />
                    </div>
                    <span asp-validation-for="PeopleCultureWorkshops" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="OtherRevenues" class="form-label fw-bold">Other Revenues</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="OtherRevenues" type="number" step="0.01" min="0" class="form-control" />
                    </div>
                    <span asp-validation-for="OtherRevenues" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Notes" class="form-label fw-bold">Notes <span class="text-muted fw-normal">(optional)</span></label>
                <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-controller="DataEntry" asp-action="RecordHistory" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

<style>
    .input-group-text {
        background-color: var(--onejax-navy);
        color: white;
        border-color: var(--onejax-navy);
    }
</style>
